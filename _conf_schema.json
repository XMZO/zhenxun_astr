{
  "template_management": {
    "type": "object",
    "description": "签到模板管理",
    "hint": "上传后请保存配置。",
    "items": {
      "packages": {
        "type": "file",
        "description": "模板 ZIP",
        "hint": "支持拖拽和多选。",
        "file_types": [
          "zip"
        ],
        "default": []
      },
      "activate_latest": {
        "type": "bool",
        "description": "自动应用新模板",
        "hint": "安装成功后自动切换。",
        "default": true
      }
    }
  },
  "timezone": {
    "type": "string",
    "description": "签到时区",
    "hint": "用于判重和卡片时间。",
    "default": "Asia/Shanghai"
  },
  "show_user_id": {
    "type": "bool",
    "description": "显示用户 ID",
    "hint": "关闭后隐藏真实 ID。",
    "default": true
  },
  "uid_value": {
    "type": "string",
    "description": "固定 UID",
    "hint": "留空使用发送者 ID。",
    "default": ""
  },
  "rewards": {
    "type": "object",
    "description": "奖励预留",
    "hint": "默认关闭，暂不执行效果。",
    "items": {
      "enable_gold": {
        "type": "bool",
        "description": "记录金币",
        "default": false
      },
      "gold_min": {
        "type": "int",
        "description": "金币下限",
        "condition": {
          "enable_gold": true
        },
        "default": 1
      },
      "gold_max": {
        "type": "int",
        "description": "金币上限",
        "condition": {
          "enable_gold": true
        },
        "default": 100
      },
      "enable_item_placeholder": {
        "type": "bool",
        "description": "记录预留道具",
        "default": false
      },
      "item_pool": {
        "type": "list",
        "description": "预留道具池",
        "condition": {
          "enable_item_placeholder": true
        },
        "default": []
      }
    }
  }
}

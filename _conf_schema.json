{
  "template_management": {
    "type": "object",
    "description": "签到模板管理",
    "hint": "上传后请保存配置。",
    "items": {
      "active_template": {
        "type": "string",
        "description": "当前模板",
        "hint": "上传保存后刷新列表。",
        "options": [
          "default",
          "tpl_fb516978e6e841458199c80ad1f6bcc5"
        ],
        "labels": [
          "官方默认模板",
          "夏娜"
        ],
        "default": "default"
      },
      "packages": {
        "type": "file",
        "description": "模板 ZIP",
        "hint": "支持拖拽和多选。",
        "file_types": [
          "zip"
        ],
        "default": []
      },
      "activate_latest": {
        "type": "bool",
        "description": "自动应用新模板",
        "hint": "安装成功后自动切换。",
        "default": true
      }
    }
  },
  "render_backend": {
    "type": "string",
    "description": "图片渲染方式",
    "hint": "自动优先本地。",
    "options": [
      "auto",
      "local",
      "remote"
    ],
    "labels": [
      "自动（推荐）",
      "本地浏览器",
      "远程 T2I"
    ],
    "default": "auto"
  },
  "image_cache": {
    "type": "object",
    "description": "每日图片缓存",
    "hint": "同一用户当天复用首次图片。",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用每日缓存",
        "hint": "次日自动清理旧图片。",
        "default": true
      }
    }
  },
  "favour_integration": {
    "type": "object",
    "description": "好感度联动",
    "hint": "可选好感联动。",
    "items": {
      "provider": {
        "type": "string",
        "description": "联动插件",
        "options": [
          "none",
          "favour_ultra"
        ],
        "labels": [
          "关闭联动",
          "Favour Ultra"
        ],
        "default": "none"
      },
      "mode": {
        "type": "string",
        "description": "联动模式",
        "condition": {
          "provider": "favour_ultra"
        },
        "options": [
          "display_reward",
          "display_only"
        ],
        "labels": [
          "显示并奖励",
          "仅显示"
        ],
        "default": "display_reward"
      },
      "reward_mode": {
        "type": "string",
        "description": "签到增加方式",
        "condition": {
          "provider": "favour_ultra",
          "mode": "display_reward"
        },
        "options": [
          "fixed",
          "random"
        ],
        "labels": [
          "固定数值",
          "随机范围"
        ],
        "default": "fixed"
      },
      "reward_value": {
        "type": "int",
        "description": "固定增加值",
        "condition": {
          "provider": "favour_ultra",
          "mode": "display_reward",
          "reward_mode": "fixed"
        },
        "default": 1
      },
      "reward_min": {
        "type": "int",
        "description": "随机下限",
        "condition": {
          "provider": "favour_ultra",
          "mode": "display_reward",
          "reward_mode": "random"
        },
        "default": 1
      },
      "reward_max": {
        "type": "int",
        "description": "随机上限",
        "condition": {
          "provider": "favour_ultra",
          "mode": "display_reward",
          "reward_mode": "random"
        },
        "default": 3
      },
      "touch_interaction": {
        "type": "bool",
        "description": "刷新互动时间",
        "hint": "签到计入活跃时间。",
        "condition": {
          "provider": "favour_ultra",
          "mode": "display_reward"
        },
        "default": true
      },
      "attitude_source": {
        "type": "string",
        "description": "态度文字来源",
        "condition": {
          "provider": "favour_ultra"
        },
        "options": [
          "relationship_or_level",
          "level",
          "relationship"
        ],
        "labels": [
          "关系优先",
          "好感等级",
          "关系名称"
        ],
        "default": "relationship_or_level"
      },
      "heart_mode": {
        "type": "string",
        "description": "爱心填充算法",
        "condition": {
          "provider": "favour_ultra"
        },
        "options": [
          "level",
          "range"
        ],
        "labels": [
          "按等级进度",
          "按全局范围"
        ],
        "default": "level"
      }
    }
  },
  "command_prefix_mode": {
    "type": "string",
    "description": "指令前缀",
    "hint": "选择签到触发方式。",
    "options": [
      "slash",
      "none",
      "hash",
      "custom"
    ],
    "labels": [
      "/ 斜杠",
      "无前缀",
      "# 井号",
      "自定义"
    ],
    "default": "slash"
  },
  "custom_command_prefix": {
    "type": "string",
    "description": "自定义前缀",
    "hint": "最长 16 字符，不含空格。",
    "condition": {
      "command_prefix_mode": "custom"
    },
    "default": "!"
  },
  "timezone": {
    "type": "string",
    "description": "签到时区",
    "hint": "用于判重和卡片时间。",
    "default": "Asia/Shanghai"
  },
  "show_user_id": {
    "type": "bool",
    "description": "显示真实 ID",
    "hint": "关闭后显示内部序号。",
    "default": true
  },
  "uid_value": {
    "type": "string",
    "description": "固定 UID",
    "hint": "留空使用发送者 ID。",
    "default": ""
  },
  "rewards": {
    "type": "object",
    "description": "奖励预留",
    "hint": "默认关闭，暂不执行效果。",
    "items": {
      "enable_gold": {
        "type": "bool",
        "description": "记录金币",
        "default": false
      },
      "gold_min": {
        "type": "int",
        "description": "金币下限",
        "condition": {
          "enable_gold": true
        },
        "default": 1
      },
      "gold_max": {
        "type": "int",
        "description": "金币上限",
        "condition": {
          "enable_gold": true
        },
        "default": 100
      },
      "enable_item_placeholder": {
        "type": "bool",
        "description": "记录预留道具",
        "default": false
      },
      "item_pool": {
        "type": "list",
        "description": "预留道具池",
        "condition": {
          "enable_item_placeholder": true
        },
        "default": []
      }
    }
  }
}
